# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://anafor.tech
# "Sign in" target (the product app)                          [APP_URL]
NEXT_PUBLIC_APP_URL=
# Contact address used by "Talk to us", the footer and JSON-LD
NEXT_PUBLIC_CONTACT_EMAIL=contact@anafor.tech
# Request access form: JSON POST target (CRM webhook, Formspree, internal API)   [FORM_ENDPOINT]
FORM_ENDPOINT=
# Optional bearer token sent to FORM_ENDPOINT
FORM_ENDPOINT_TOKEN=
