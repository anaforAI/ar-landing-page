# Public site URL (canonical, sitemap, Open Graph)           [SITE_URL]
NEXT_PUBLIC_SITE_URL=https://anafor.ai
# "Sign in" target (the product app)                          [APP_URL]
NEXT_PUBLIC_APP_URL=
# Contact address used by "Talk to us" and the footer          [CONTACT_EMAIL]
NEXT_PUBLIC_CONTACT_EMAIL=hello@anafor.ai
# Request access form: JSON POST target (CRM webhook, Formspree, internal API)   [FORM_ENDPOINT]
FORM_ENDPOINT=
# Optional bearer token sent to FORM_ENDPOINT
FORM_ENDPOINT_TOKEN=
